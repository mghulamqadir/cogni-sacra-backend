# App
NODE_ENV=development
PORT=4000
SERVER_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# MongoDB URI
MONGO_URI=mongodb://localhost:27017/cogni_sacra

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Brevo
BREVO_API_KEY=xkeysib-...
SENDER_EMAIL=noreply@example.com
SENDER_NAME=Cogni Sacra

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI Tutor (OpenAI low-cost default)
AI_PROVIDER=openai
AI_API_KEY=sk-...
AI_MODEL=gpt-5-nano
AI_TUTOR_MAX_CONTEXT_TOKENS=6000
AI_TUTOR_MAX_QUESTION_CHARS=2000
AI_TUTOR_RATE_LIMIT_PER_HOUR=30

# Optional MVP features
FEATURE_VIRTUAL_LIBRARY=true
FEATURE_PAID_ENROLLMENT=true
LOG_LEVEL=info

# Idempotent platform-admin seed
PLATFORM_ADMIN_NAME=Platform Admin
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=replace_with_a_12_character_or_longer_password
