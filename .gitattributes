# Auto-detect text files and normalize line endings
* text=auto

# Force LF for code/config (works even if a dev has autocrlf enabled)
*.ts   text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sh   text eol=lf
*.md   text eol=lf

# Binary files (never modify)
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.pdf  binary
